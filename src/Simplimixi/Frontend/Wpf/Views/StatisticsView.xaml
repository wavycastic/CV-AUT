<UserControl x:Class="CvAut.WpfApp.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="720">
    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRevealStyle}" Margin="12,6,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,6,16,0">
            <ui:TextBlock FontSize="42"
                          FontWeight="Black"
                          Text="Statistics" />
            <ui:TextBlock Margin="0,-2,0,0"
                          FontTypography="Body"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Overview of your battle performance" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" MinHeight="124" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" Style="{StaticResource PanelCardStyle}">
                            <Image Width="30"
                                   Height="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_attack.png}" />
                        </Border>
                        <ui:TextBlock Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      FontTypography="Caption"
                                      Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Text="TOTAL BATTLES" />
                    </StackPanel>
                    <ui:TextBlock Grid.Row="1"
                                  Margin="0,4,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="44"
                                  FontWeight="Bold"
                                  Text="{Binding AttacksCountText}" />
                    <ui:TextBlock Grid.Row="2"
                                  Style="{StaticResource MetricLabelStyle}"
                                  Text="Battles this session" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="14,12" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="34" Height="34" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_gold.png}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="Gold" />
                            <ui:TextBlock FontSize="24" FontWeight="Bold" Text="{Binding GoldGainedText}" />
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding AvgGoldPerHourText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Polyline Stretch="Fill"
                                  Stroke="{StaticResource GlassCardStrokeBrush}"
                                  StrokeThickness="2"
                                  Points="0,26 132,26" />
                        <Polyline Stretch="Fill"
                                  Stroke="#FFFFA31A"
                                  StrokeThickness="2"
                                  Points="{Binding GoldSparklinePoints}">
                            <Polyline.Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGoldStats}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polyline.Style>
                        </Polyline>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Padding="14,12" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="34" Height="34" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_elixir.png}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="Elixir" />
                            <ui:TextBlock FontSize="24" FontWeight="Bold" Text="{Binding ElixirGainedText}" />
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding AvgElixirPerHourText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Polyline Stretch="Fill"
                                  Stroke="{StaticResource GlassCardStrokeBrush}"
                                  StrokeThickness="2"
                                  Points="0,26 132,26" />
                        <Polyline Stretch="Fill"
                                  Stroke="#FFFF3BD5"
                                  StrokeThickness="2"
                                  Points="{Binding ElixirSparklinePoints}">
                            <Polyline.Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasElixirStats}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polyline.Style>
                        </Polyline>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="6" Padding="14,12" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="34" Height="34" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_de.png}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="Dark Elixir" />
                            <ui:TextBlock FontSize="24" FontWeight="Bold" Text="{Binding DarkElixirGainedText}" />
                            <ui:TextBlock Style="{StaticResource MetricLabelStyle}" Text="{Binding AvgDarkElixirPerHourText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Polyline Stretch="Fill"
                                  Stroke="{StaticResource GlassCardStrokeBrush}"
                                  StrokeThickness="2"
                                  Points="0,26 132,26" />
                        <Polyline Stretch="Fill"
                                  Stroke="#FFB977FF"
                                  StrokeThickness="2"
                                  Points="{Binding DarkElixirSparklinePoints}">
                            <Polyline.Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDarkElixirStats}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polyline.Style>
                        </Polyline>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="16,0,16,0" Padding="18,14" Style="{StaticResource StatCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Text="STAR RESULT" />

                <Rectangle Grid.Row="1"
                           Height="1"
                           Margin="0,6,0,0"
                           Fill="{StaticResource GlassCardStrokeBrush}" />

                <UniformGrid Grid.Row="2" Columns="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="56" Height="56" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_0 star.png}" />
                        <ui:TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="{Binding Star0CountText}" />
                        <ui:TextBlock HorizontalAlignment="Center" Foreground="{StaticResource DangerBrush}" Text="0 star" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="56" Height="56" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_1 star.png}" />
                        <ui:TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="{Binding Star1CountText}" />
                        <ui:TextBlock HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" Text="1 star" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="56" Height="56" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_2 star.png}" />
                        <ui:TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="{Binding Star2CountText}" />
                        <ui:TextBlock HorizontalAlignment="Center" Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}" Text="2 stars" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="56" Height="56" Source="{Binding Converter={StaticResource TemplateImageConverter}, ConverterParameter=icon_3 star.png}" />
                        <ui:TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Text="{Binding Star3CountText}" />
                        <ui:TextBlock HorizontalAlignment="Center" Foreground="{StaticResource ReadyBrush}" Text="3 stars" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
