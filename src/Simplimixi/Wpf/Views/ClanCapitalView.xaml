<UserControl x:Class="CvAut.WpfApp.Views.ClanCapitalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="520">
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,8,16,12">
            <ui:TextBlock FontTypography="Title" Text="Clan Capital" />
            <ui:TextBlock Margin="0,2,0,0"
                          Appearance="Secondary"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Feature is currently disabled for this build." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,16" MaxWidth="430" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource GamingCardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="78"
                                Height="78"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Opacity="0.55"
                                ClipToBounds="True">
                            <Image Stretch="UniformToFill"
                                   Source="pack://siteoforigin:,,,/Templates/Clan Capital/Attacks enemy village/CH_9_ref_min.png" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{StaticResource WarningBrush}"
                                          Text="DISABLED" />
                            <ui:TextBlock Margin="0,4,0,0"
                                          FontTypography="BodyStrong"
                                          Text="Clan Capital automation is not active" />
                            <ui:TextBlock Margin="0,4,0,0"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="This screen is kept as a visual placeholder only. No raid map detection, district selection or capital attack flow will run from here." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GamingCardStyle}" Padding="14" Opacity="0.72">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Text="NOT ENABLED" />
                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0"
                                               Symbol="LockClosed24"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock FontTypography="BodyStrong"
                                              Text="Raid controls are hidden" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0"
                                               Symbol="ShieldDismiss24"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock FontTypography="BodyStrong"
                                              Text="Raid runner is not wired to this tab" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
