<ui:FluentWindow x:Class="CvAut.WpfApp.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewmodels="clr-namespace:CvAut.WpfApp.ViewModels"
                 xmlns:views="clr-namespace:CvAut.WpfApp.Views"
                 Title="Simplimixi v0.5.0"
                 Width="680"
                 Height="480"
                 MinWidth="680"
                 MinHeight="480"
                 MaxWidth="680"
                 MaxHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{StaticResource WindowFallbackBackgroundBrush}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:GeneralViewModel}">
            <views:GeneralView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ArmyViewModel}">
            <views:ArmyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MultiVillageViewModel}">
            <views:MultiVillageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClanGamesViewModel}">
            <views:ClanGamesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClanCapitalViewModel}">
            <views:ClanCapitalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ui:NavigationView x:Name="RootNavigationView"
                           Padding="0"
                           PaneDisplayMode="Left"
                           CompactPaneLength="60"
                           OpenPaneLength="160"
                           IsPaneOpen="True"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           TitleBar="{Binding ElementName=AppTitleBar}"
                           Transition="FadeInWithSlide">
            <ui:NavigationView.PaneHeader>
                <Border Height="60" Background="Transparent">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigationView}" Value="True">
                                    <Setter Property="Margin" Value="16,0,16,8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon FontSize="22"
                                   VerticalAlignment="Center"
                                   Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Symbol="Bot24">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="{x:Type ui:SymbolIcon}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigationView}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Border>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.PaneFooter>
                <Border Margin="12,8,12,12"
                        Background="Transparent">
                    <ui:Button Command="{Binding TogglePauseCommand}"
                               IsEnabled="{Binding IsPauseButtonEnabled}"
                               HorizontalAlignment="Stretch"
                               Height="36"
                               Padding="0">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Content" Value="Pause" />
                                <Setter Property="Icon" Value="{ui:SymbolIcon Pause24}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusPillText}" Value="PAUSED">
                                        <Setter Property="Background" Value="{StaticResource ReadyBrush}" />
                                        <Setter Property="Content" Value="Resume" />
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Border>
            </ui:NavigationView.PaneFooter>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="GeneralNavigationItem"
                                       Content="General"
                                       ToolTip="General"
                                       Tag="general"
                                       Command="{Binding NavigateGeneralCommand}"
                                       Icon="{ui:SymbolIcon Settings24}" />
                <ui:NavigationViewItem Content="Army"
                                       ToolTip="Army"
                                       Tag="army"
                                       Command="{Binding NavigateArmyCommand}"
                                       Icon="{ui:SymbolIcon Shield24}" />
                <ui:NavigationViewItem Content="Multi-Village"
                                       ToolTip="Multi-Village"
                                       Tag="multivillage"
                                       Command="{Binding NavigateMultiVillageCommand}"
                                       Icon="{ui:SymbolIcon BuildingHome24}" />
                <ui:NavigationViewItem Content="Clan Games"
                                       ToolTip="Clan Games"
                                       Tag="clangames"
                                       Command="{Binding NavigateClanGamesCommand}"
                                       Icon="{ui:SymbolIcon Trophy24}" />
                <ui:NavigationViewItem Content="Clan Capital"
                                       ToolTip="Clan Capital"
                                       Tag="clancapital"
                                       Command="{Binding NavigateClanCapitalCommand}"
                                       Icon="{ui:SymbolIcon Building24}" />
                <ui:NavigationViewItem Content="Statistics"
                                       ToolTip="Statistics"
                                       Tag="statistics"
                                       Command="{Binding NavigateStatisticsCommand}"
                                       Icon="{ui:SymbolIcon Poll24}" />
                <ui:NavigationViewItem Content="Logs"
                                       ToolTip="Logs"
                                       Tag="logs"
                                       Command="{Binding NavigateLogsCommand}"
                                       Icon="{ui:SymbolIcon DocumentText24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid Margin="6,0,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Height="3"
                                 Margin="0,0,0,4"
                                 IsIndeterminate="True"
                                 BorderThickness="0"
                                 Background="Transparent">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusPillText}" Value="RUNNING">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding CurrentViewModel}" />

                    <!-- Fixed Control Dock at the bottom -->
                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="12,10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Bot Status info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding StatusPillBrush}"
                                         Margin="2,0,8,0" />
                                <ui:TextBlock FontTypography="BodyStrong"
                                              Text="{Binding StatusPillText}"
                                              VerticalAlignment="Center" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding UptimeText, StringFormat=' | Uptime: {0}'}"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Control Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Start"
                                           Command="{Binding StartCommand}"
                                           IsEnabled="{Binding IsStartButtonEnabled}"
                                           Appearance="Primary"
                                           Background="{StaticResource ReadyBrush}"
                                           BorderBrush="Transparent"
                                           Foreground="Black"
                                           FontWeight="Bold"
                                           Width="92"
                                           Margin="0,0,8,0"
                                           Icon="{ui:SymbolIcon Play24}" />

                                <ui:Button Content="End"
                                           Command="{Binding StopCommand}"
                                           IsEnabled="{Binding IsEndButtonEnabled}"
                                           Appearance="Secondary"
                                           Width="92"
                                           Icon="{ui:SymbolIcon Stop24}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar x:Name="AppTitleBar"
                     Title="Simplimixi v0.5.0"
                     Margin="0"
                     ShowHelp="False"
                     ShowMaximize="False" />
    </Grid>
</ui:FluentWindow>
