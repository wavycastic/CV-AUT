<UserControl x:Class="CvAut.WpfApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="520">
    <Grid Style="{StaticResource PageRevealStyle}" Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <StackPanel Grid.Row="0" Margin="16,8,16,12">
            <ui:TextBlock FontTypography="Title" Text="Information" />
            <ui:TextBlock Margin="0,2,0,0"
                           Appearance="Secondary"
                           FontTypography="Caption"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Review application information and current licensing status." />
        </StackPanel>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="16,4,16,16" MaxWidth="480" HorizontalAlignment="Stretch">

                <!-- Security Alert Card -->
                <Border Style="{StaticResource GamingCardStyle}" Padding="16" BorderBrush="{StaticResource DangerBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Danger Icon Badge -->
                        <Border Grid.Column="0"
                                Width="78"
                                Height="78"
                                Background="{StaticResource GlassPanelBackgroundBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1.5"
                                CornerRadius="12">
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Symbol="ShieldDismiss24"
                                           FontSize="38"
                                           Foreground="{StaticResource DangerBrush}" />
                        </Border>

                        <!-- Text Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{StaticResource DangerBrush}"
                                          FontWeight="Bold"
                                          Text="IMPORTANT NOTICE" />
                            <ui:TextBlock Margin="0,4,0,0"
                                          FontTypography="BodyStrong"
                                          FontSize="16"
                                          Foreground="White"
                                          Text="{Binding SecurityAlertTitle, Mode=OneWay}" />
                            <ui:TextBlock Margin="0,4,0,0"
                                          FontTypography="Caption"
                                          FontSize="13.5"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="{Binding SecurityAlertContent, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Software Info Card -->
                <Border Style="{StaticResource GamingCardStyle}" Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Text="APPLICATION INFORMATION" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="Software Version" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1" Text="v0.6.0" FontTypography="BodyStrong" Foreground="White" />
                        </Grid>

                        <Separator Margin="0,12,0,12" Background="{StaticResource GlassCardStrokeBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="Current License" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1" Text="Currently free" FontTypography="BodyStrong" Foreground="{StaticResource ReadyBrush}" />
                        </Grid>

                        <Separator Margin="0,12,0,12" Background="{StaticResource GlassCardStrokeBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="Developer/Support" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1" Text="SimpliMixi Team" FontTypography="BodyStrong" Foreground="White" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
