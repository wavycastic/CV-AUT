<Window x:Class="CvAut.WpfApp.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SimpliMixi Update"
        Width="460"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowFallbackBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SubtitleTextBlock"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesTextBlock"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <StackPanel x:Name="ProgressPanel"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="ProgressTextBlock"
                           Margin="0,0,0,8"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Đang chuẩn bị tải bản cập nhật..." />
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100" />
            </StackPanel>

            <StackPanel x:Name="ActionPanel"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button x:Name="LaterButton"
                           Margin="0,0,10,0"
                           Appearance="Secondary"
                           Content="Nhắc lại sau"
                           Click="LaterButton_Click" />
                <ui:Button x:Name="UpdateButton"
                           Appearance="Primary"
                           Content="Cập nhật ngay"
                           Click="UpdateButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
