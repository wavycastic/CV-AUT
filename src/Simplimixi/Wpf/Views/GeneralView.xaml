<UserControl x:Class="CvAut.WpfApp.Views.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="680">
    <Grid Style="{StaticResource PageRevealStyle}" Margin="4,8,4,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <StackPanel Margin="12,0,12,8">
                        <ItemsControl HorizontalAlignment="Center"
                                      ItemsSource="{Binding ArmyVM.AttackCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="74"
                                            Height="96"
                                            Margin="0,0,6,8"
                                            Padding="7,7"
                                            Background="{StaticResource GlassPanelBackgroundBrush}"
                                            BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Width="52"
                                                    Height="52"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="7">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ImagePath}" Stretch="Uniform" />
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,5,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            MinHeight="286"
                            Padding="16"
                            Background="{StaticResource GlassCardBackgroundBrush}"
                            BorderBrush="{StaticResource GlassCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel>
                            <Grid Height="32">
                                <ui:TextBlock VerticalAlignment="Center"
                                              FontTypography="Caption"
                                              Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Text="LOOT THRESHOLDS" />
                            </Grid>
                            <Border Height="68"
                                    Margin="0,14,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="22" Height="22" Margin="0,0,8,0" Source="pack://siteoforigin:,,,/assets/Templates/icon_gold.png" />
                                        <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Gold" />
                                    </StackPanel>
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="104"
                                                  HorizontalAlignment="Right"
                                                  Minimum="0"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Gold"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding GoldThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border Height="68"
                                    Margin="0,12,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="22" Height="22" Margin="0,0,8,0" Source="pack://siteoforigin:,,,/assets/Templates/icon_elixir.png" />
                                        <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Elixir" />
                                    </StackPanel>
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="104"
                                                  HorizontalAlignment="Right"
                                                  Minimum="0"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Elixir"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding ElixirThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <Border Height="68"
                                    Margin="0,12,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="22" Height="22" Margin="0,0,8,0" Source="pack://siteoforigin:,,,/assets/Templates/icon_de.png" />
                                        <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Dark" />
                                    </StackPanel>
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="104"
                                                  HorizontalAlignment="Right"
                                                  Minimum="0"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Dark"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding DarkThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            MinHeight="286"
                            Padding="16"
                            Background="{StaticResource GlassCardBackgroundBrush}"
                            BorderBrush="{StaticResource GlassCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                              VerticalAlignment="Center"
                                              FontTypography="Caption"
                                              Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Text="WALL UPGRADES" />
                                <ui:ToggleSwitch Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding UpgradeWallEnabled}" />
                            </Grid>

                            <StackPanel IsEnabled="{Binding IsWallInputsEnabled}">
                                <Border Height="68"
                                        Margin="0,14,0,0"
                                        Padding="12,0"
                                        Background="{StaticResource GlassPanelBackgroundBrush}"
                                        BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="72" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="22" Height="22" Margin="0,0,8,0" Source="pack://siteoforigin:,,,/assets/Templates/icon_gold.png" />
                                            <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Gold" />
                                        </StackPanel>
                                        <ui:NumberBox Grid.Column="1"
                                                      Width="96"
                                                      HorizontalAlignment="Right"
                                                      Minimum="0"
                                                      MaxDecimalPlaces="0"
                                                      PlaceholderText="Reserve"
                                                      SpinButtonPlacementMode="Compact"
                                                      Text="{Binding WallGoldThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <Border Height="68"
                                        Margin="0,12,0,0"
                                        Padding="12,0"
                                        Background="{StaticResource GlassPanelBackgroundBrush}"
                                        BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="72" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="22" Height="22" Margin="0,0,8,0" Source="pack://siteoforigin:,,,/assets/Templates/icon_elixir.png" />
                                            <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Elixir" />
                                        </StackPanel>
                                        <ui:NumberBox Grid.Column="1"
                                                      Width="96"
                                                      HorizontalAlignment="Right"
                                                      Minimum="0"
                                                      MaxDecimalPlaces="0"
                                                      PlaceholderText="Reserve"
                                                      SpinButtonPlacementMode="Compact"
                                                      Text="{Binding WallElixirThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <Border Height="68"
                                        Margin="0,12,0,0"
                                        Padding="12,0"
                                        Background="{StaticResource GlassPanelBackgroundBrush}"
                                        BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="72" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      FontTypography="BodyStrong"
                                                      Text="Target" />
                                        <ui:NumberBox Grid.Column="1"
                                                      Width="72"
                                                      HorizontalAlignment="Right"
                                                      Minimum="1"
                                                      Maximum="20"
                                                      MaxDecimalPlaces="0"
                                                      PlaceholderText="Level"
                                                      SpinButtonPlacementMode="Compact"
                                                      Text="{Binding WallLevel, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            MinHeight="286"
                            Padding="16"
                            Background="{StaticResource GlassCardBackgroundBrush}"
                            BorderBrush="{StaticResource GlassCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel>
                            <Grid Height="32">
                                <ui:TextBlock VerticalAlignment="Center"
                                              FontTypography="Caption"
                                              Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Text="TRAIN MODE" />
                            </Grid>

                            <Border Height="68"
                                    Margin="0,14,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="BodyStrong"
                                                  Text="Smart train" />
                                    <RadioButton Grid.Column="1"
                                                 MinWidth="24"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Content=" "
                                                 IsChecked="{Binding ArmyVM.IsSmartTrain}" />
                                </Grid>
                            </Border>

                            <Border Height="68"
                                    Margin="0,12,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="BodyStrong"
                                                  Text="Quick train" />
                                    <RadioButton Grid.Column="1"
                                                 MinWidth="24"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Content=" "
                                                 IsChecked="{Binding ArmyVM.IsQuickTrain}" />
                                </Grid>
                            </Border>

                            <Border Height="68"
                                    Margin="0,12,0,0"
                                    Padding="12,0"
                                    Background="{StaticResource GlassPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource GlassCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    IsEnabled="{Binding ArmyVM.IsQuickSlotEnabled}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" FontTypography="BodyStrong" Text="Slot" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="86"
                                                  HorizontalAlignment="Right"
                                                  Minimum="1"
                                                  Maximum="2"
                                                  MaxDecimalPlaces="0"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding ArmyVM.QuickSlot, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
