<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CvAut</RootNamespace>
    <AssemblyName>AutoClashOfClan20206</AssemblyName>
    <Product>AutoClashOfClan20206</Product>
    <Version>0.6.2</Version>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <FileVersion>0.6.2.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\AppIcon\SimpliMixi.ico</ApplicationIcon>
    <!-- Compiled bindings are required for Native AOT (no runtime XAML reflection). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <!--
    Native AOT for the FRONTEND app project. The app consumes the Backend library
    (which also carries PublishAot=true to enable AOT analysis), so the whole app
    compiles to a single native binary with no IL shipped — the core security win.

    Publish from a Developer Command Prompt (vcvars64) with:
      IlcUseEnvironmentalTools=true
    and ensure MSVC link.exe precedes Git's usr/bin/link.exe in PATH
    (Git ships a Unix hardlink tool named link.exe that breaks LinkNative).
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- Strip PDB/symbols from the native binary so the shipped .exe carries no debug metadata. -->
    <StripSymbols>true</StripSymbols>
    <!-- Avalonia XAML is compiled at build time by Avalonia.BuildServices, so it is AOT-safe. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Simplimixi.Frontend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.0.5" />

    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- Dev tools: debug only, excluded from Release/AOT output. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- MVVM source generators (ObservableObject/[RelayCommand]) — AOT-safe, no reflection. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DI composition root. Manual registration only — AOT-safe (no assembly scanning). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Icon library: strongly-typed MaterialIconKind enum + switch-based path data → AOT/trim safe. -->
    <PackageReference Include="Material.Icons" Version="3.0.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\Simplimixi.Backend.csproj" />
  </ItemGroup>

  <!-- Avalonia app sources (FE only — Program.cs here replaces the headless Core/Program.cs). -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="App.axaml.cs" />
    <Compile Include="ViewLocator.cs" />
    <Compile Include="AppLog.cs" />
    <Compile Include="Converters\LogLevelToBrushConverter.cs" />
    <Compile Include="ConfigStore.cs" />
    <Compile Include="ViewModels\ViewModelBase.cs" />
    <Compile Include="ViewModels\MainWindowViewModel.cs" />
    <Compile Include="ViewModels\DashboardViewModel.cs" />
    <Compile Include="ViewModels\DeviceViewModel.cs" />
    <Compile Include="ViewModels\SessionStatsViewModel.cs" />
    <Compile Include="ViewModels\TopBarViewModel.cs" />
    <Compile Include="ViewModels\SidebarViewModel.cs" />
    <Compile Include="ViewModels\SettingsViewModel.cs" />
    <Compile Include="ViewModels\AdvancedViewModel.cs" />
    <Compile Include="ViewModels\LogsViewModel.cs" />
    <Compile Include="ViewModels\LicenseViewModel.cs" />
    <Compile Include="ViewModels\SetupWizardViewModel.cs" />
    <Compile Include="ViewModels\Settings\MainVillageViewModel.cs" />
    <Compile Include="ViewModels\Settings\NightVillageViewModel.cs" />
    <Compile Include="ViewModels\Settings\ClanGamesViewModel.cs" />
    <Compile Include="ViewModels\Settings\ClanCapitalViewModel.cs" />
    <Compile Include="Views\MainWindow.axaml.cs" />
    <Compile Include="Views\DashboardView.axaml.cs" />
    <Compile Include="Views\SettingsView.axaml.cs" />
    <Compile Include="Views\AdvancedView.axaml.cs" />
    <Compile Include="Views\LogsView.axaml.cs" />
    <Compile Include="Views\LicenseView.axaml.cs" />
    <Compile Include="Views\HeaderView.axaml.cs" />
    <Compile Include="Views\StatusBarView.axaml.cs" />
    <Compile Include="Views\BottomNavView.axaml.cs" />
    <Compile Include="Views\DevicePanelView.axaml.cs" />
    <Compile Include="Views\DeviceListItemView.axaml.cs" />
    <Compile Include="Views\Settings\MainVillageView.axaml.cs" />
    <Compile Include="Views\Settings\NightVillageView.axaml.cs" />
    <Compile Include="Views\Settings\ClanGamesView.axaml.cs" />
    <Compile Include="Views\Settings\ClanCapitalView.axaml.cs" />
    <Compile Include="Views\SetupWizardView.axaml.cs" />
    <Compile Include="Models\BotStatus.cs" />
    <Compile Include="Models\PlayMode.cs" />
    <Compile Include="Models\NotificationSettings.cs" />
    <Compile Include="Models\DashboardDeviceState.cs" />
    <Compile Include="Models\Device.cs" />
    <Compile Include="Models\LogEntry.cs" />
    <Compile Include="Models\SessionStats.cs" />
    <Compile Include="Services\AppStateService.cs" />
    <Compile Include="Services\Sessions\IDeviceSession.cs" />
    <Compile Include="Services\Sessions\IDeviceSessionManager.cs" />
    <Compile Include="Services\Sessions\AutomationRunnerSession.cs" />
    <Compile Include="Services\Sessions\MockDeviceSession.cs" />
    <Compile Include="Services\Notifications\INotificationService.cs" />
    <Compile Include="Services\Sessions\DeviceSessionManager.cs" />
    <Compile Include="Services\Emulators\IEmulatorDiscovery.cs" />
    <Compile Include="Services\Emulators\IDeviceScanner.cs" />
    <Compile Include="Services\Emulators\CommonPorts.cs" />
    <Compile Include="Services\Emulators\AdbConnector.cs" />
    <Compile Include="Services\Emulators\AdbEndpoint.cs" />
    <Compile Include="Services\Emulators\Scanners\AdbConnectedDeviceScanner.cs" />
    <Compile Include="Services\Emulators\Scanners\BlueStacksScanner.cs" />
    <Compile Include="Services\Emulators\Scanners\VendorScanners.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\Backgrounds\**\*" />
    <AvaloniaResource Include="..\..\assets\AppIcon\SimpliMixiIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\adb\**\*" Link="adb\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\assets\Templates\**\*" Link="assets\Templates\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Dev/script/doc artifacts must never ship in the protected package; the
         Test-ProtectedPackage gate in build-installer.ps1 forbids these extensions. -->
    <None Remove="..\..\assets\Templates\**\*.py" />
    <None Remove="..\..\assets\Templates\**\*.md" />
    <None Remove="..\..\assets\Templates\**\*.cs" />
    <None Remove="..\..\assets\Templates\**\*.csx" />
    <None Remove="..\..\assets\Templates\**\*.ps1" />
    <None Remove="..\..\assets\Templates\**\*.psm1" />
    <None Remove="..\..\assets\Templates\**\*.psd1" />
    <None Remove="..\..\assets\Templates\**\*.cmd" />
    <None Remove="..\..\assets\Templates\**\*.bat" />
    <None Remove="..\..\assets\Templates\**\*.sh" />
    <None Include="..\..\config\test_config.json" Link="Config\test_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\native\bin\win-x64\Release\simplimixi_native.dll" Link="simplimixi_native.dll" Condition="Exists('..\native\bin\win-x64\Release\simplimixi_native.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
