<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:views="using:CvAut.Views"
    xmlns:conv="using:CvAut.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
>
    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.device-card">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 22 0 #20000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.device-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
            <Setter Property="BoxShadow" Value="0 12 28 0 #24000000" />
        </Style>
        <Style Selector="Button.compact-action">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.scan-ring">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.72" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.72" />
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="materialIcons|MaterialIcon.scan-spinner">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.scan-dot">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.scan-dot.delay-one">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.18" IterationCount="Infinite" PlaybackDirection="Alternate" FillMode="Backward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.scan-dot.delay-two">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.36" IterationCount="Infinite" PlaybackDirection="Alternate" FillMode="Backward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!--
            1. Vertical View (Single Device Mode) - device list above, detail below.
        -->
        <Grid IsVisible="{Binding !IsGridMode}">
            <Grid RowDefinitions="Auto,*" Margin="14,12" IsVisible="{Binding !ShowActivePanel}">
                <!-- Top: Connected Devices -->
                <Border Grid.Row="0" Margin="0,0,0,10"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                Background="{DynamicResource AppAccentSoftBrush}"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1">
                            <materialIcons:MaterialIcon Kind="CellphoneLink" Width="17" Height="17"
                                                        Foreground="{DynamicResource AppAccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Thiết bị kết nối" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DeviceSummaryText}" Classes="caption"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding EmulatorFilters}"
                                  SelectedItem="{Binding SelectedEmulatorFilter}"
                                  MinWidth="112" Height="32" FontSize="11" Padding="9,4"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="3" Command="{Binding DetectDevicesCommand}" Classes="ghost"
                                Padding="0" ToolTip.Tip="Quét lại thiết bị" CornerRadius="8"
                                Width="32" Height="32" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15"
                                                        Classes.scan-spinner="{Binding IsDetecting}"
                                                        Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Devices items list -->
                <Border Grid.Row="1"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}" Padding="10">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Apps" Width="15" Height="15"
                                                            Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="Instance tìm thấy" Classes="labelStrong" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="28" CornerRadius="8"
                                    Background="{DynamicResource AppConsoleBrush}"
                                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,Auto,Auto">
                                    <!-- Start -->
                                    <Button Grid.Column="0"
                                            Classes="seg-start"
                                            Classes.active-start="{Binding IsRunning}"
                                            Command="{Binding StartAllCommand}"
                                            Height="26" CornerRadius="0"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khởi chạy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Vertical divider -->
                                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource AppBorderStrongBrush}" />

                                    <!-- Stop -->
                                    <Button Grid.Column="2"
                                            Classes="seg-end"
                                            Classes.active-stop="{Binding IsStopped}"
                                            Command="{Binding StopAllCommand}"
                                            Height="26" CornerRadius="0"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Stop" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dừng" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <!-- Device ListBox -->
                            <ListBox Name="DeviceList" ItemsSource="{Binding Devices}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     IsVisible="{Binding DeviceCount}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                                                <BrushTransition Property="Background" Duration="0:0:0.2" />
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    </Style>
                                    <!-- Action buttons inside ListBoxItem: smooth subtle hover without harsh white box -->
                                    <Style Selector="ListBoxItem Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#15ffffff" />
                                    </Style>
                                    <Style Selector="ListBoxItem Button.ghost:pointerover materialIcons|MaterialIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DeviceViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                                            <!-- Emulator Icon -->
                                            <Image Grid.RowSpan="2" Grid.Column="0" Source="{Binding EmulatorIcon}" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <!-- Device Name -->
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Subtitle Info -->
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubTitleText}" Classes="caption" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- Play Mode Dropdown -->
                                            <ComboBox Grid.RowSpan="2" Grid.Column="2" ItemsSource="{Binding PlayModes}" SelectedItem="{Binding SelectedPlayMode}" Width="98" Height="26" FontSize="11" Padding="5,2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <!-- Status Pill Badge -->
                                            <Border Grid.RowSpan="2" Grid.Column="3" CornerRadius="10" Background="#12ffffff" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Action Buttons -->
                                            <StackPanel Grid.RowSpan="2" Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <!-- Selection Toggle Button -->
                                                <ToggleButton IsChecked="{Binding IsSelected}" 
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="0" Width="26" Height="26" 
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                              ToolTip.Tip="Chọn thiết bị">
                                                    <ToggleButton.Styles>
                                                        <Style Selector="ToggleButton">
                                                            <Setter Property="Content">
                                                                <Template>
                                                                    <materialIcons:MaterialIcon Kind="CircleOutline" Width="15" Height="15" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </Template>
                                                            </Setter>
                                                        </Style>
                                                        <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </Style>
                                                        <Style Selector="ToggleButton:checked">
                                                            <Setter Property="Content">
                                                                <Template>
                                                                    <materialIcons:MaterialIcon Kind="CheckCircle" Width="15" Height="15" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </Template>
                                                            </Setter>
                                                        </Style>
                                                        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </Style>
                                                        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                        <Style Selector="ToggleButton:pointerover materialIcons|MaterialIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                        </Style>
                                                    </ToggleButton.Styles>
                                                </ToggleButton>
                                                
                                                <!-- Configure button -->
                                                <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ConfigureDeviceCommand}" CommandParameter="{Binding}" Padding="0" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Cấu hình">
                                                    <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </Button>

                                                <!-- Logs button -->
                                                <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ShowDeviceLogsCommand}" CommandParameter="{Binding}" Padding="0" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Nhật ký">
                                                    <materialIcons:MaterialIcon Kind="ScriptText" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty state appears only after a scan returns no devices. -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding ShowEmptyNoDevices}" Spacing="16">
                                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1">
                                    <materialIcons:MaterialIcon Kind="CellphoneLinkOff" Width="30" Height="30" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="KHÔNG TÌM THẤY THIẾT BỊ" FontWeight="Bold" FontSize="13" LetterSpacing="1.2" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mở giả lập rồi bấm nút quét lại." Classes="caption" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!--
            2. Grid Mode Pane (Phase 3) - visible when in Grid Mode
        -->
        <ScrollViewer IsVisible="{Binding ShowGridPane}">
            <ItemsControl Name="GridDeviceList" ItemsSource="{Binding Devices}" Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DeviceViewModel">
                        <Border Classes="device-card">
                            <StackPanel Spacing="10">
                                <!-- Row 1: Name + Status LED -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                                                Background="{DynamicResource AppSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                            <materialIcons:MaterialIcon Kind="Cellphone" Width="15" Height="15"
                                                                        Foreground="{DynamicResource AppAccentBrush}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" Classes="h3" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
 
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding DisplayStatusColor}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding DisplayStatus}" Classes="label" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
 
                                <!-- Row 2: Play Mode ComboBox + Source -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Chế độ chạy:" Classes="label" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding PlayModes}" SelectedItem="{Binding SelectedPlayMode}"
                                                  Width="130" Height="30" FontSize="12" Padding="8,4" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Chi tiết >" Classes="ghost" Command="{Binding #GridDeviceList.DataContext.SelectDeviceCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Xem chi tiết" FontSize="11" Padding="8,4" Height="28" />
                                </Grid>
 
                                <!-- Row 3: Stats -->
                                <Border Background="{DynamicResource AppConsoleBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="10,8">
                                    <Grid ColumnDefinitions="*,*,*,*" VerticalAlignment="Center">
                                        <!-- Battles -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Sword" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Stats.Battles}" Classes="statNum" FontSize="12" />
                                        </StackPanel>
                                        <!-- Gold -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Coins" Width="14" Height="14" Foreground="{DynamicResource AppGoldBrush}" />
                                            <TextBlock Text="{Binding Stats.Gold, StringFormat='{}{0:#,##0}'}" Classes="statNum" FontSize="12" Foreground="{DynamicResource AppGoldBrush}" />
                                        </StackPanel>
                                        <!-- Elixir -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Water" Width="14" Height="14" Foreground="{DynamicResource AppElixirBrush}" />
                                            <TextBlock Text="{Binding Stats.Elixir, StringFormat='{}{0:#,##0}'}" Classes="statNum" FontSize="12" Foreground="{DynamicResource AppElixirBrush}" />
                                        </StackPanel>
                                        <!-- Dark Elixir -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="SkullOutline" Width="14" Height="14" Foreground="{DynamicResource AppDarkElixirBrush}" />
                                            <TextBlock Text="{Binding Stats.DarkElixir, StringFormat='{}{0:#,##0}'}" Classes="statNum" FontSize="12" Foreground="{DynamicResource AppDarkElixirBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
 
                                <!-- Row 4: Action Buttons -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Grid Grid.Column="0">
                                        <Button Background="{DynamicResource AppSuccessBrush}" Foreground="White" Classes="compact-action" Command="{Binding StartCommand}" IsVisible="{Binding ShowStartButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="White"/>
                                                <TextBlock Text="Chạy" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="danger compact-action" Command="{Binding StopCommand}" IsVisible="{Binding ShowStopButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" />
                                                <TextBlock Text="DỪNG" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
 
                                    <Button Grid.Column="1" Classes="compact-action" Command="{Binding #GridDeviceList.DataContext.ConfigureDeviceCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="Cấu hình" FontSize="11" />
                                        </StackPanel>
                                    </Button>
 
                                    <Button Grid.Column="2" Classes="compact-action" Command="{Binding #GridDeviceList.DataContext.ShowDeviceLogsCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="ScriptText" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="Nhật ký" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading overlay with clear 3D layer separation and floating card container -->
        <Grid IsVisible="{Binding IsDetecting}"
              Background="#d80b0b10"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Floating Card Panel -->
            <Border Width="220" Padding="20,18" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                    BoxShadow="0 16 48 0 #a0000000">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <!-- Minimalist Spinning Loading Icon -->
                    <materialIcons:MaterialIcon Classes="scan-spinner" Kind="Loading" Width="32" Height="32"
                                                Foreground="{DynamicResource AppAccentBrush}"
                                                HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon.RenderTransform><RotateTransform /></materialIcons:MaterialIcon.RenderTransform>
                    </materialIcons:MaterialIcon>

                    <TextBlock Text="Đang quét giả lập..." FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
