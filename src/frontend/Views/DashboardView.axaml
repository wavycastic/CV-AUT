<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:views="using:CvAut.Views"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
>
    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="0">

        <!-- Toolbar: detect devices + grid toggle (Phase 1 single mode) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,8,12,0">
            <Button Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DetectDevicesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                    <TextBlock Text="Detect devices" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Single mode: render the active device panel. Grid mode (Phase 3) swaps this for an ItemsControl. -->
        <ContentControl Grid.Row="1" Content="{Binding ActiveDevice}" IsVisible="{Binding ActiveDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.Styles>
                <Style Selector="ContentControl:not(:null)">
                    <!-- placeholder style so the inner view fills -->
                </Style>
            </ContentControl.Styles>
        </ContentControl>

        <!-- Empty state when no active device -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding ActiveDevice, Converter={x:Static ObjectConverters.IsNull}}">
            <materialIcons:MaterialIcon Kind="Devices" Width="48" Height="48" />
            <TextBlock Text="No device yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Click 'Detect devices' to list connected emulators."
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
