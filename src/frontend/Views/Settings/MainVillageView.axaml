<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels.Settings"
    xmlns:settings="using:CvAut.Views.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.Settings.MainVillageView"
    x:DataType="vm:MainVillageViewModel"
>
    <Design.DataContext><vm:MainVillageViewModel /></Design.DataContext>

    <!-- Scroll host only. Each card is its own control and inherits this DataContext. -->
    <ScrollViewer Background="Transparent" Padding="10" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,0,0,50">
            <settings:MainVillageAttackView />
            <settings:MainVillageResourceThresholdsView />
            <settings:MainVillageWallUpgradeView />
            <settings:MainVillageSurrenderView />
        </StackPanel>
    </ScrollViewer>
</UserControl>
