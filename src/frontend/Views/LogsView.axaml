<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:models="using:CvAut.Models"
    xmlns:conv="using:CvAut.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.LogsView"
    x:DataType="vm:LogsViewModel">
    <Design.DataContext><vm:LogsViewModel /></Design.DataContext>

    <UserControl.Resources>
        <conv:LogLevelToBrushConverter x:Key="LevelToBrush" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Copy" Command="{Binding CopyCommand}" Height="32" />
            <Button Content="Export" Command="{Binding ExportCommand}" Height="32" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True" BorderThickness="1"
                Background="{DynamicResource AppConsoleBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="8">
            <Grid>
                <TextBlock Text="Không có log phù hợp" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasFilteredLogs}" />

                <ListBox Name="LogList" ItemsSource="{Binding FilteredLogs}" Background="Transparent"
                          BorderThickness="0" Padding="0" IsVisible="{Binding HasFilteredLogs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedLevel}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2" Text="{Binding FormattedModule}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="3" Text="{Binding CleanMessage}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource AppLogTextBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,6" />
    </Grid>
</UserControl>
