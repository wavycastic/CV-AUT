<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:models="using:CvAut.Models"
    xmlns:conv="using:CvAut.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.LogsView"
    x:DataType="vm:LogsViewModel">
    <Design.DataContext><vm:LogsViewModel /></Design.DataContext>

    <UserControl.Resources>
        <conv:LogLevelToBrushConverter x:Key="LevelToBrush" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">
        <!-- Row 0: Mode Switcher Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <RadioButton Content="Nhật ký hoạt động (User)" IsChecked="{Binding IsUserMode}" GroupName="LogModeGroup" Classes="accent" Height="30" Padding="12,4"/>
            <RadioButton Content="Nhật ký kỹ thuật (Dev)" IsChecked="{Binding !IsUserMode}" GroupName="LogModeGroup" Classes="accent" Height="30" Padding="12,4"/>
        </StackPanel>

        <!-- Row 1: The Log Console -->
        <Border Grid.Row="1" CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True" BorderThickness="1"
                Background="{DynamicResource AppConsoleBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="12,10">
            <Grid>
                <TextBlock Text="Không có log phù hợp" Classes="muted"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasFilteredLogs}" />

                <ListBox Name="LogList" ItemsSource="{Binding FilteredLogs}" Background="Transparent"
                          BorderThickness="0" Padding="0" IsVisible="{Binding HasFilteredLogs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" 
                                           FontSize="12" Foreground="#80A0A0A0" VerticalAlignment="Top" />

                                <!-- Icon or Severity -->
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" 
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" 
                                           VerticalAlignment="Top" Width="18" TextAlignment="Center"/>

                                <!-- Subsystem the line came from -->
                                <TextBlock Grid.Column="2" Text="{Binding FormattedModuleLabel}"
                                           FontSize="11.5" Foreground="#A0A0A0A0"
                                           VerticalAlignment="Top" MinWidth="96"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Message / Summary -->
                                <TextBlock Grid.Column="3" Text="{Binding Summary}" 
                                           FontSize="12.5" 
                                           LineHeight="18"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" 
                                           TextWrapping="Wrap" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Row 2: Bottom Control Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- Left: Status -->
            <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="#80A0A0A0" FontSize="12" VerticalAlignment="Center"/>
            <!-- Right: Copy Button -->
            <Button Grid.Column="1" Content="Sao chép nhật ký" Command="{Binding CopyCommand}" Height="32" Padding="16,0" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
