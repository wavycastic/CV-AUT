<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="CvAut.Views.BottomNavView"
    x:DataType="vm:SidebarViewModel"
>
    <Design.DataContext>
        <vm:SidebarViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.nav-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.nav-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.nav-btn:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        </Style>
        <Style Selector="Button.nav-btn.active materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Height="60"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
        <Border Width="420" Height="44" Padding="4" CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <Button Classes="nav-btn"
                                Command="{Binding $parent[UserControl].DataContext.NavigateCommand}"
                                CommandParameter="{Binding}"
                                Classes.active="{Binding IsActive}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="17" Height="17"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Border>
</UserControl>
