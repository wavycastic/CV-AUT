<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.LicenseView"
    x:DataType="vm:LicenseViewModel"
>
    <Design.DataContext>
        <vm:LicenseViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <Border Width="84" Height="84" CornerRadius="{DynamicResource RadiusMd}"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="KeyVariant" Width="40" Height="40"
                                        Foreground="{DynamicResource AppAccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title}" Classes="h2" HorizontalAlignment="Center" />
        <TextBlock
            Text="(Khung giao diện Phase 0 — tính năng bản quyền sẽ được kết nối ở Phase 4)"
            Classes="muted"
            HorizontalAlignment="Center"
        />
    </StackPanel>
</UserControl>
