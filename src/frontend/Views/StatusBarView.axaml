<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="CvAut.Views.StatusBarView"
    x:DataType="vm:TopBarViewModel"
>
    <Design.DataContext>
        <vm:TopBarViewModel />
    </Design.DataContext>

    <Border Height="32"
            Padding="12,0"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Circle" Width="8" Height="8"
                                                Foreground="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RunningCount}" Classes="chip" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="đang chạy" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="•" Classes="muted" FontSize="11" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Trophy" Width="10" Height="10"
                                                Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalStars}" Classes="chip" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="sao" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="•" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasErrors}" />

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasErrors}">
                    <materialIcons:MaterialIcon Kind="AlertCircle" Width="10" Height="10"
                                                Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorCount}" Classes="chip" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="lỗi" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
