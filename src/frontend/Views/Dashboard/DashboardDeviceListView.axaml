<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:dashboard="using:CvAut.Views.Dashboard"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.Dashboard.DashboardDeviceListView"
    x:DataType="vm:DashboardViewModel"
>
    <Design.DataContext><vm:DashboardViewModel /></Design.DataContext>

    <UserControl.Styles>
        <StyleInclude Source="/Views/Dashboard/DashboardStyles.axaml" />
        <StyleInclude Source="/Views/Dashboard/DashboardDeviceListStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="14,12" IsVisible="{Binding !ShowActivePanel}">
        <!-- Top: Connected Devices -->
        <dashboard:DashboardDeviceListHeaderView Grid.Row="0" Margin="0,0,0,10" />

        <!-- Devices items list -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}" Padding="10">
            <Grid RowDefinitions="Auto,*">
                <dashboard:DashboardDeviceListToolbarView Grid.Row="0" Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <!--
                        The row template stays in this file: its Configure and Logs buttons bind
                        through #DeviceList, and that name only resolves inside the file that
                        declares the ListBox.
                    -->
                    <ListBox Name="DeviceList" ItemsSource="{Binding Devices}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             IsVisible="{Binding DeviceCount}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                                    <!-- Emulator Icon -->
                                    <Image Grid.RowSpan="2" Grid.Column="0" Source="{Binding EmulatorIcon}" Width="18" Height="18" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <!-- Device Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Subtitle Info -->
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubTitleText}" Classes="caption" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Play Mode Dropdown -->
                                    <ComboBox Grid.RowSpan="2" Grid.Column="2" ItemsSource="{Binding PlayModes}" SelectedItem="{Binding SelectedPlayMode}" Width="98" Height="26" FontSize="11" Padding="5,2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Status Pill Badge -->
                                    <Border Grid.RowSpan="2" Grid.Column="3" CornerRadius="10" Background="#12ffffff" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.RowSpan="2" Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <!-- Selection Toggle Button, styled by ToggleButton.device-select in DashboardDeviceListStyles.axaml -->
                                        <ToggleButton Classes="device-select"
                                                      IsChecked="{Binding IsSelected}" 
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="0" Width="26" Height="26" 
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      ToolTip.Tip="Chọn thiết bị"/>

                                        <!-- Configure button -->
                                        <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ConfigureDeviceCommand}" CommandParameter="{Binding}" Padding="0" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Cấu hình">
                                            <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </Button>

                                        <!-- Logs button -->
                                        <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ShowDeviceLogsCommand}" CommandParameter="{Binding}" Padding="0" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Nhật ký">
                                            <materialIcons:MaterialIcon Kind="ScriptText" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <dashboard:DashboardDeviceListEmptyState VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             IsVisible="{Binding ShowEmptyNoDevices}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
