<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:dashboard="using:CvAut.Views.Dashboard"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.Dashboard.DashboardDeviceListView"
    x:DataType="vm:DashboardViewModel"
>
    <Design.DataContext><vm:DashboardViewModel /></Design.DataContext>

    <UserControl.Styles>
        <StyleInclude Source="/Views/Dashboard/DashboardStyles.axaml" />
        <StyleInclude Source="/Views/Dashboard/DashboardDeviceListStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="14,12" IsVisible="{Binding !ShowActivePanel}">
        <!-- Top: Connected Devices -->
        <dashboard:DashboardDeviceListHeaderView Grid.Row="0" Margin="0,0,0,10" />

        <!-- Devices items list -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}" Padding="10">
            <Grid RowDefinitions="Auto,*,Auto">
                <dashboard:DashboardDeviceListToolbarView Grid.Row="0" Margin="0,0,0,10" />

                <Grid Grid.Row="1">
                    <!--
                        The row template stays in this file: its Configure and Logs buttons bind
                        through #DeviceList, and that name only resolves inside the file that
                        declares the ListBox.
                    -->
                    <ListBox Name="DeviceList" ItemsSource="{Binding Devices}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             IsVisible="{Binding DeviceCount}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:DeviceViewModel">
                                <!--
                                    Two-line row. The window is fixed at 480px, so name + endpoint +
                                    play mode + badge + actions cannot share one line without the
                                    endpoint and the play mode label both getting ellipsised.
                                -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                                    <!--
                                        Selection Toggle leads the row: it chooses run targets, so it must not
                                        sit among the per-row icon actions where it reads as a status stamp.
                                        Styled by ToggleButton.device-select in DashboardDeviceListStyles.axaml.
                                    -->
                                    <ToggleButton Grid.RowSpan="2" Grid.Column="0"
                                                  Classes="device-select"
                                                  IsChecked="{Binding IsSelected}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0" Width="28" Height="28"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip.Tip="{Binding SelectionHint}"/>
                                    <!-- Emulator Icon -->
                                    <Image Grid.RowSpan="2" Grid.Column="1" Source="{Binding EmulatorIcon}" Width="18" Height="18" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Device Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                                    <!-- Status Pill Badge -->
                                    <Border Grid.Row="0" Grid.Column="3" CornerRadius="12" Background="#12ffffff" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8,3" VerticalAlignment="Center" Margin="6,0,6,0"
                                            ToolTip.Tip="{Binding DeviceStatusText}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Action Buttons. Selection lives at the head of the row, not here. -->
                                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <!-- Configure button -->
                                        <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ConfigureDeviceCommand}" CommandParameter="{Binding}" Padding="0" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Cấu hình">
                                            <materialIcons:MaterialIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </Button>

                                        <!-- Logs button -->
                                        <Button Classes="ghost" Command="{Binding #DeviceList.DataContext.ShowDeviceLogsCommand}" CommandParameter="{Binding}" Padding="0" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Nhật ký">
                                            <materialIcons:MaterialIcon Kind="ScriptText" Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>

                                    <!--
                                        Second line: endpoint and play mode get the full remaining width,
                                        so neither "BlueStacks • Port 5555" nor "Làng chính" is truncated.
                                    -->
                                    <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding SubTitleText}" Classes="caption" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SubTitleText}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PlayModes}" SelectedItem="{Binding SelectedPlayMode}" MinWidth="124" Height="28" FontSize="11" Padding="8,0" VerticalAlignment="Center" ToolTip.Tip="Chế độ chơi áp dụng cho instance này"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <dashboard:DashboardDeviceListEmptyState VerticalAlignment="Center" HorizontalAlignment="Center"
                                                             IsVisible="{Binding ShowEmptyNoDevices}" />
                </Grid>

                <!--
                    The list rarely fills the pane, so the leftover space carries the one rule that is
                    not self-evident from the row: what the yellow check actually decides.
                -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Background="{DynamicResource AppConsoleBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        IsVisible="{Binding DeviceCount}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CheckCircle" Width="13" Height="13"
                                                    Foreground="{DynamicResource AppAccentBrush}"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding DeviceListHintText}" Classes="caption" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
