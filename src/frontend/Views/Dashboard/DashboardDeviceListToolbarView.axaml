<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CvAut.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="CvAut.Views.Dashboard.DashboardDeviceListToolbarView"
    x:DataType="vm:DashboardViewModel"
>
    <Design.DataContext><vm:DashboardViewModel /></Design.DataContext>

    <StackPanel Spacing="8">
        <!-- Primary fleet actions. -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Apps" Width="16" Height="16"
                                            Foreground="{DynamicResource AppAccentBrush}"/>
                <!-- The header card already reports what was detected; this block is about what will run. -->
                <TextBlock Text="Instance sẽ chạy" Classes="labelStrong" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1" Height="34" CornerRadius="8"
                    Background="{DynamicResource AppConsoleBrush}"
                    BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <Button Grid.Column="0"
                            Classes="seg-start primary-cta"
                            Classes.active-start="{Binding IsRunning}"
                            Command="{Binding StartAllCommand}"
                            ToolTip.Tip="{Binding FleetStartHint}"
                            Height="32" CornerRadius="0" Padding="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Khởi chạy" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource AppBorderStrongBrush}" />

                    <Button Grid.Column="2"
                            Classes="seg-end"
                            Classes.active-stop="{Binding IsStopped}"
                            Command="{Binding StopAllCommand}"
                            ToolTip.Tip="{Binding FleetStopHint}"
                            Height="32" CornerRadius="0" Padding="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dừng" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Selection is independent from ListBox focus: the yellow check marks are the run targets. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="{Binding FleetSelectionText}" Classes="caption"
                       FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="chip" Command="{Binding SelectAllDevicesCommand}"
                    Content="Chọn tất cả" Height="28" Padding="10,0" FontSize="11"
                    ToolTip.Tip="Chọn toàn bộ instance trong danh sách"/>
            <Button Grid.Column="2" Classes="chip" Command="{Binding ClearDeviceSelectionCommand}"
                    Content="Bỏ chọn" Height="28" Padding="10,0" FontSize="11"
                    ToolTip.Tip="Bỏ chọn toàn bộ instance"/>
        </Grid>
    </StackPanel>
</UserControl>
