<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="CvAut.App"
    xmlns:local="using:CvAut"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:semi="clr-namespace:Semi.Avalonia;assembly=Semi.Avalonia"
    RequestedThemeVariant="Dark"
>
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Design system tokens. Views reference these via DynamicResource so a
                    future theme switch only needs to swap the values there, never every view.
                -->
                <ResourceInclude Source="/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme />
        <materialIcons:MaterialIconStyles />

        <!--
            Load order matters: later includes win on equal specificity. This is the same
            order the styles appeared in when they all lived in this file.
        -->
        <StyleInclude Source="/Styles/Typography.axaml" />
        <StyleInclude Source="/Styles/Buttons.axaml" />
        <StyleInclude Source="/Styles/Indicators.axaml" />
        <StyleInclude Source="/Styles/Inputs.axaml" />
        <StyleInclude Source="/Styles/Surfaces.axaml" />
        <StyleInclude Source="/Styles/Scrollbars.axaml" />
    </Application.Styles>
</Application>
