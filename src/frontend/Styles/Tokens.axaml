<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!--
        Design system tokens (Phase 1). Views reference these via DynamicResource so a
        future theme switch only needs to swap the values here, never every view.
    -->

    <!-- Dark Gaming Console colors (Clash of Clans inspired) -->
    <Color x:Key="AppBackgroundColor">#0a0a0c</Color>
    <Color x:Key="AppSurfaceColor">#14141a</Color>
    <Color x:Key="AppSurfaceAltColor">#1e1e26</Color>
    <Color x:Key="AppSurfaceHoverColor">#2a2a31</Color>
    <Color x:Key="AppBorderColor">#242430</Color>
    <Color x:Key="AppBorderStrongColor">#363642</Color>
    <!-- Console surface (near-black) + modal scrim overlay -->
    <Color x:Key="AppConsoleColor">#050508</Color>
    <Color x:Key="AppScrimColor">#B3050509</Color>

    <!-- Text (CoC warm primary / muted console text) -->
    <Color x:Key="AppTextPrimaryColor">#f0f0f2</Color>
    <Color x:Key="AppTextSecondaryColor">#b8b8c4</Color>
    <Color x:Key="AppTextMutedColor">#78788a</Color>

    <!-- Gold Accent (Clash of Clans Gold) -->
    <Color x:Key="AppAccentColor">#d4af37</Color>
    <Color x:Key="AppAccentHoverColor">#e6c44a</Color>
    <Color x:Key="AppAccentSoftColor">#1a1608</Color>
    <Color x:Key="AppAccentTextColor">#0a0a0c</Color>
    <Color x:Key="AppAccentBorderColor">#d4af37</Color>

    <!-- Elixir (Pink) & Dark Elixir (Purple) -->
    <Color x:Key="AppElixirColor">#d946ef</Color>
    <Color x:Key="AppElixirSoftColor">#1a0a1e</Color>
    <Color x:Key="AppDarkElixirColor">#8b5cf6</Color>
    <Color x:Key="AppDarkElixirSoftColor">#0f0a1e</Color>

    <!-- Semantic (Gaming Neon) -->
    <Color x:Key="AppSuccessColor">#22c55e</Color>
    <Color x:Key="AppSuccessSoftColor">#1822c55e</Color>
    <Color x:Key="AppSuccessHoverColor">#cc22c55e</Color>
    <Color x:Key="AppSuccessTextColor">#ff22c55e</Color>
    <Color x:Key="AppSuccessBorderColor">#8022c55e</Color>
    <Color x:Key="AppDangerColor">#ef4444</Color>
    <Color x:Key="AppDangerSoftColor">#18ef4444</Color>
    <Color x:Key="AppDangerHoverColor">#ccef4444</Color>
    <Color x:Key="AppDangerTextColor">#ffef4444</Color>
    <Color x:Key="AppDangerBorderColor">#80ef4444</Color>
    <Color x:Key="AppInfoColor">#06b6d4</Color>

    <!-- Brushes (what views actually bind) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAltColor}" />
    <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{StaticResource AppSurfaceHoverColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{StaticResource AppBorderStrongColor}" />
    <SolidColorBrush x:Key="AppConsoleBrush" Color="{StaticResource AppConsoleColor}" />
    <SolidColorBrush x:Key="AppConsoleBgBrush" Color="{StaticResource AppConsoleColor}" />
    <SolidColorBrush x:Key="AppScrimBrush" Color="{StaticResource AppScrimColor}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />
    <SolidColorBrush x:Key="AppLogTimeBrush" Color="{StaticResource AppTextMutedColor}" />
    <SolidColorBrush x:Key="AppLogDeviceBrush" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppLogTextBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="{StaticResource AppAccentTextColor}" />
    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="{StaticResource AppAccentBorderColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="{StaticResource AppSuccessSoftColor}" />
    <SolidColorBrush x:Key="AppSuccessHoverBrush" Color="{StaticResource AppSuccessHoverColor}" />
    <SolidColorBrush x:Key="AppSuccessTextBrush" Color="{StaticResource AppSuccessTextColor}" />
    <SolidColorBrush x:Key="AppSuccessBorderBrush" Color="{StaticResource AppSuccessBorderColor}" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="{StaticResource AppDangerSoftColor}" />
    <SolidColorBrush x:Key="AppDangerHoverBrush" Color="{StaticResource AppDangerHoverColor}" />
    <SolidColorBrush x:Key="AppDangerTextBrush" Color="{StaticResource AppDangerTextColor}" />
    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="{StaticResource AppDangerBorderColor}" />
    <SolidColorBrush x:Key="AppElixirBrush" Color="{StaticResource AppElixirColor}" />
    <SolidColorBrush x:Key="AppElixirSoftBrush" Color="{StaticResource AppElixirSoftColor}" />
    <SolidColorBrush x:Key="AppDarkElixirBrush" Color="{StaticResource AppDarkElixirColor}" />
    <SolidColorBrush x:Key="AppDarkElixirSoftBrush" Color="{StaticResource AppDarkElixirSoftColor}" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />

    <!-- Spacing scale (4 / 8 / 12 / 16 / 24) -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>

    <!-- Corner radii (Modern gaming rounded values) -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>

    <BoxShadows x:Key="ShadowCard">0 1 3 0 #40000000</BoxShadows>
    <BoxShadows x:Key="ShadowTile">0 1 2 0 #30000000</BoxShadows>
</ResourceDictionary>
