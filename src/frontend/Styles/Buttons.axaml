<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
>
    <!-- Base (secondary / ghost-ish): subtle surface, clear hover. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>

    <!-- Primary / accent button -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentTextBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Success button -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.success /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSuccessHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="#0a0a0c" />
    </Style>

    <!-- Danger button -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource AppDangerTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppDangerTextBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
        <Setter Property="TextElement.Foreground" Value="#0a0a0c" />
    </Style>

    <!-- Segmented pill buttons (Start / Stop halves) -->
    <Style Selector="Button.seg-start,
                    Button.seg-end">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.seg-start /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10,0,0,10" />
    </Style>
    <Style Selector="Button.seg-end /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0,10,10,0" />
    </Style>
    <Style Selector="Button.seg-start:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
    </Style>
    <Style Selector="Button.seg-end:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppDangerTextBrush}" />
    </Style>
    <Style Selector="Button.seg-start:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
    </Style>
    <Style Selector="Button.seg-end:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
    </Style>
    <Style Selector="Button.seg-start:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.seg-end:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!--
        Primary emphasis for the fleet Start action. Declared BEFORE the active-start block on
        purpose: once the fleet is running, active-start must win and repaint the half green.
    -->
    <Style Selector="Button.seg-start.primary-cta">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg-start.primary-cta /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentTextBrush}" />
    </Style>
    <Style Selector="Button.seg-start.primary-cta:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
    </Style>
    <Style Selector="Button.seg-start.primary-cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentTextBrush}" />
    </Style>
    <!-- Disabled must drop the accent fill, otherwise a dead button still reads as the CTA. -->
    <Style Selector="Button.seg-start.primary-cta:disabled">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="Button.seg-start.primary-cta:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>

    <!-- Segmented pill active states (Green for Running / Red for Stopped) -->
    <Style Selector="Button.seg-start.active-start">
        <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Animations>
            <Animation Duration="0:0:1.3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.4" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.seg-start.active-start /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
    </Style>

    <Style Selector="Button.seg-end.active-stop">
        <Setter Property="Foreground" Value="{DynamicResource AppDangerTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.seg-end.active-stop /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppDangerTextBrush}" />
    </Style>

    <!--
        Chip button: low-emphasis but still visibly a button. Used for the selection helpers
        next to the fleet counters, where a flat text link read as a static label.
    -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource AppConsoleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chip:disabled">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Ghost button: transparent, used for nav / icon-only actions -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
    </Style>

    <!-- Sidebar active nav state -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav.active materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
</Styles>
