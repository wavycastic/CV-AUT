<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <!--
    Conservative WPF-safe profile for the WPF app, plus stronger backend obfuscation.
    Publish first, then run Obfuscar against the published assemblies.
  -->
  <Var name="InPath" value="publish\win-x64-obfuscator-input" />
  <Var name="OutPath" value="publish\win-x64-obfuscated" />
  <AssemblySearchPath path="publish\win-x64-obfuscator-deps" />
  <AssemblySearchPath
        path="C:\Program Files\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\8.0.27\ref\net8.0"
    />
  <AssemblySearchPath
        path="C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Ref\8.0.27\ref\net8.0"
    />

  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="ReuseNames" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="CopyDependencies" value="false" />

  <!-- Keep the WPF assembly unobfuscated for now; XAML bindings and generated code are reflection-sensitive. -->
  <Module file="$(InPath)\Simplimixi.Backend.dll">
    <!-- Backend can use the stronger global rules above; keep property renaming off until tested. -->
    <SkipNamespace name="OpenCvSharp" />
    <SkipNamespace name="SharpAdbClient" />
  </Module>
</Obfuscator>
