<UserControl x:Class="CvAut.WpfApp.Views.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="520">
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,8,16,12">
            <ui:TextBlock FontTypography="Title" Text="General" />
            <ui:TextBlock Margin="0,2,0,0"
                          Appearance="Secondary"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Compact resource and wall settings." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,4,16,16" MaxWidth="430" HorizontalAlignment="Stretch">
                <!-- Card 1: Resources -->
                <Border Style="{StaticResource GamingCardStyle}" Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Text="LOOT THRESHOLDS" />

                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="20" Height="20" Margin="0,0,10,0" Source="pack://siteoforigin:,,,/Templates/icon_gold.png" />
                                    <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Gold Threshold" />
                                </StackPanel>
                                <ui:NumberBox Grid.Column="1"
                                              Width="116"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Minimum="0"
                                              MaxDecimalPlaces="0"
                                              PlaceholderText="Gold"
                                              SpinButtonPlacementMode="Compact"
                                              Text="{Binding GoldThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="20" Height="20" Margin="0,0,10,0" Source="pack://siteoforigin:,,,/Templates/icon_elixir.png" />
                                    <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Elixir Threshold" />
                                </StackPanel>
                                <ui:NumberBox Grid.Column="1"
                                              Width="116"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Minimum="0"
                                              MaxDecimalPlaces="0"
                                              PlaceholderText="Elixir"
                                              SpinButtonPlacementMode="Compact"
                                              Text="{Binding ElixirThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="20" Height="20" Margin="0,0,10,0" Source="pack://siteoforigin:,,,/Templates/icon_de.png" />
                                    <ui:TextBlock VerticalAlignment="Center" FontTypography="BodyStrong" Text="Dark Elixir" />
                                </StackPanel>
                                <ui:NumberBox Grid.Column="1"
                                              Width="116"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Minimum="0"
                                              MaxDecimalPlaces="0"
                                              PlaceholderText="Dark"
                                              SpinButtonPlacementMode="Compact"
                                              Text="{Binding DarkThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 2: Wall Upgrade -->
                <Border Style="{StaticResource GamingCardStyle}" Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="20" Height="20" Margin="0,0,10,0" Source="pack://siteoforigin:,,,/Templates/icon_wall.png" />
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="Caption"
                                                  Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Text="WALL UPGRADES" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                  FontTypography="BodyStrong"
                                                  Text="Use extra loot for wall upgrades" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             Margin="10,0,0,0"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding UpgradeWallEnabled}" />
                        </Grid>

                        <Border Padding="12,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4,0,0"
                                IsEnabled="{Binding IsWallInputsEnabled}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="BodyStrong"
                                                  Text="Gold Reserve" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="116"
                                                  HorizontalAlignment="Right"
                                                  Minimum="0"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Reserve"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding WallGoldThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="BodyStrong"
                                                  Text="Elixir Reserve" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="116"
                                                  HorizontalAlignment="Right"
                                                  Minimum="0"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Reserve"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding WallElixirThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="BodyStrong"
                                                  Text="Target Wall Level" />
                                    <ui:NumberBox Grid.Column="1"
                                                  Width="116"
                                                  HorizontalAlignment="Right"
                                                  Minimum="1"
                                                  Maximum="20"
                                                  MaxDecimalPlaces="0"
                                                  PlaceholderText="Level"
                                                  SpinButtonPlacementMode="Compact"
                                                  Text="{Binding WallLevel, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
